# ─── API ─────────────────────────────────────────────────────────────────
# Point at your Kaki server. For local dev on Expo Go, this must be your Mac's
# LAN IP, not localhost (the phone can't resolve localhost).
# Example: http://192.168.1.42:3456
EXPO_PUBLIC_API_URL=http://localhost:3456

# ─── Stripe (publishable key — safe to ship in client) ──────────────────
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
