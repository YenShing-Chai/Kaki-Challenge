# ─── Database (Render Postgres or any Postgres) ─────────────────────────
# Both should point at the same Postgres instance. DIRECT_URL is used by
# drizzle-kit migrate; DATABASE_URL is used at runtime. With Render they're
# usually identical (no pooler).
DATABASE_URL=postgresql://user:password@host.singapore-postgres.render.com/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host.singapore-postgres.render.com/dbname?sslmode=require

# ─── Auth ───────────────────────────────────────────────────────────────
# 32+ bytes of random base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ─── Stripe (TEST keys only — never commit live keys) ───────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Cron + admin ───────────────────────────────────────────────────────
# Bearer token required to hit admin / cron endpoints from CI.
CRON_SECRET=change-me-to-a-long-random-string
# Email of the human treated as admin (creates challenges, approves creators).
ADMIN_EMAIL=you@example.com

# ─── Server ─────────────────────────────────────────────────────────────
PORT=3456
